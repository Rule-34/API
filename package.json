{
  "name": "rule-34-api",
  "version": "0.0.1",
  "private": true,
  "packageManager": "pnpm@11.1.3",
  "author": "Alejandro Akbal",
  "main": "dist/main.js",
  "scripts": {
    "start": "node dist/main",
    "build": "nest build",
    "dev": "nest start --watch",
    "debug": "nest start --debug --watch",
    "format": "prettier --write \"src/**/*.ts\" \"!src/external/**\" \"*.{js,json}\"",
    "format:check": "prettier --check \"src/**/*.ts\" \"!src/external/**\" \"*.{js,json}\"",
    "lint": "eslint \"{src,apps,libs,test}/**/*.ts\" \"*.js\" --max-warnings=0",
    "lint:fix": "eslint \"{src,apps,libs,test}/**/*.ts\" \"*.js\" --fix",
    "typecheck": "pnpm typecheck:build && pnpm typecheck:spec",
    "typecheck:build": "tsc -p tsconfig.build.json --noEmit",
    "typecheck:spec": "tsc -p tsconfig.spec.json --noEmit",
    "verify": "pnpm lint && pnpm format:check && pnpm typecheck && pnpm build && pnpm test",
    "test": "jest",
    "test:cov": "jest --coverage",
    "test:debug": "node --inspect-brk -r tsconfig-paths/register -r ts-node/register node_modules/.bin/jest --runInBand",
    "test:watch": "jest --watch"
  },
  "jest": {
    "collectCoverageFrom": [
      "src/**/*.(t|j)s"
    ],
    "coverageDirectory": "coverage",
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": ".",
    "roots": [
      "<rootDir>/src"
    ],
    "testEnvironment": "node",
    "testRegex": ".*\\.spec\\.ts$",
    "transform": {
      "^.+\\.(t|j)s$": [
        "ts-jest",
        {
          "tsconfig": "tsconfig.spec.json"
        }
      ]
    }
  },
  "dependencies": {
    "@alejandroakbal/universal-booru-wrapper": "^0.15.25",
    "@fastify/helmet": "^13.0.2",
    "@fastify/static": "^9.1.3",
    "@nestjs/common": "^11.1.21",
    "@nestjs/config": "^4.0.4",
    "@nestjs/core": "^11.1.21",
    "@nestjs/platform-fastify": "^11.1.21",
    "@sentry/nestjs": "^10.53.1",
    "axios": "^1.16.1",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "dotenv": "^17.4.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@nestjs/cli": "^11.0.21",
    "@nestjs/schematics": "^11.1.0",
    "@nestjs/testing": "^11.1.21",
    "@types/express": "^5.0.6",
    "@types/jest": "^30.0.0",
    "@types/node": "^24.12.4",
    "@types/supertest": "^7.2.0",
    "eslint": "^10.4.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.6.0",
    "jest": "^30.4.2",
    "prettier": "^3.8.3",
    "supertest": "^7.2.2",
    "ts-jest": "^29.4.9",
    "ts-loader": "^9.5.7",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.59.4"
  },
  "engines": {
    "node": "24"
  }
}
