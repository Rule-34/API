NODE_ENV=

PORT=3000

ALLOWED_ORIGINS=r34.app,www.r34.app,alt*.r34.app

DEBUG=UBW*

# For error reporting
SENTRY_ENABLED=
SENTRY_DSN=

# For downloading private packages
GITHUB_TOKEN=

BOORU_AUTH_CONFIG='{"gelbooru.com":[{"user":"001","password":"gelbooru-api-key","rateLimit":{"requests":10,"windowSeconds":1}}],"rule34.xxx":[{"user":"002","password":"rule34-api-key","rateLimit":{"requests":60,"windowSeconds":60}}]}'

# Optional URL-rewriter proxy per provider. The proxy must accept the final upstream URL in targetParam.
BOORU_OUTBOUND_PROXY_CONFIG='{"gelbooru.com":[{"baseUrl":"https://cors-proxy2.rule34.workers.dev/","targetParam":"q"},{"baseUrl":"https://cors-proxy.refinedsoftware00.workers.dev/","targetParam":"q"}]}'
